# Clearance configuration. Copy to .env and fill in. .env is git-ignored.

# Required: the single extraction call (stage 4) and the web-fetch fallback (stage 2).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Firecrawl works keyless on a rate-limited free tier, but a key
# raises the limits and is strongly recommended.
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model for the one extraction call per guide.
LLM_MODEL=claude-opus-5-5

# Cheap model used only to drive the web_fetch tool when Firecrawl fails.
# Its prose is discarded; only the fetched page text is kept.
FETCH_MODEL=claude-haiku-5-5

# Base URL used to build shareable links in the UI when Streamlit cannot
# report its own URL.
BASE_URL=http://localhost:8501
