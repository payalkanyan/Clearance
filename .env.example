# Clearance configuration. Copy to .env and fill in. .env is git-ignored.
# A value containing xxxx is treated as unset, so the SDKs never receive a
# placeholder as a real credential.

# Required: page discovery and scraping (stage 2).
# Free key with 1000 credits at https://firecrawl.dev
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: the single extraction call (stage 4).
# Free key at https://aistudio.google.com/apikey
# May also come from your shell environment instead of this file.
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model for that one call. gemini-3.8-flash is free-tier eligible and takes a
# 1M-token input. gemini-2.5-pro is also free-tier eligible.
LLM_MODEL=gemini-3.8-flash

# Optional. Only used for the stage-2 fallback when Firecrawl fails: the
# Anthropic web_fetch tool fetches the page and we read the text out of the
# tool result. Without this key the fallback is a plain HTTP fetch instead.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FETCH_MODEL=claude-haiku-5-5

# auto (web_fetch when an Anthropic key exists, else http), web_fetch, or http.
FALLBACK_MODE=auto

# Base URL for shareable links when Streamlit cannot report its own.
BASE_URL=http://localhost:8501
